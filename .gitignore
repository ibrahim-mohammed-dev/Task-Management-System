# ==========================================
# Backend Ignore Rules (Spring Boot / Maven)
# ==========================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/src/main/resources/application.properties
backend/*.log
backend/*.env

### STS & Eclipse ###
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache

# ==========================================
# Frontend Ignore Rules (React / Node / Vite)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-isolation/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ==========================================
# IDEs & System Garbage (Global)
# ==========================================
.idea/
*.iws
*.iml
*.ipr
.vscode/
.DS_Store