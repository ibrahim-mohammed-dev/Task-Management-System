# Dependencies – reinstalled inside the container by npm ci
node_modules

# Vite build output – rebuilt inside the container
dist

# Git history – not needed in the image
.git
.gitignore
.gitattributes

# Editor/IDE config
.idea
.vscode
*.suo
*.user

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment files – never bake secrets into an image
.env
.env.*

# Docker files themselves (avoid recursive COPY confusion)
Dockerfile
.dockerignore

# Readme & docs – not needed at runtime
README.md
